        { "q": "Why was Tom happy?", "a": "He saw a panda.", "wrong": ["He was tired.", "It rained."] }
      ],
      "answers": [
        { "q": "Who went to the park?", "answer": "Tom and Anna." },
        { "q": "When did they go?", "answer": "On Sunday." },
        { "q": "What did they see?", "answer": "A panda." },
        { "q": "Where is the zoo?", "answer": "In Taipei." },
